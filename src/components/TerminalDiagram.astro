---
// Denah skematis terminal bus berjalur (mis. Terminal Blok M): jalur, peron, tangga, pintu masuk, dan rute per jalur.
// Props: terminal (kunci di src/lib/terminals.js), current (stopId yang sedang dibuka, disorot; boleh kosong)
import { TERMINALS } from "../lib/terminals.js";
import { routeLabel, loadRoutesIndex, loadStopServices, buildRouteLookup, routesForStop } from "../lib/data.js";

const { terminal, current = null } = Astro.props;
const T = TERMINALS[terminal];
const services = loadStopServices();
const lookup = buildRouteLookup(loadRoutesIndex());
const lum = hex => { const c = (hex || "#334155").replace("#", ""); const [r, g, b] = [0, 2, 4].map(i => parseInt(c.slice(i, i + 2), 16) / 255); return 0.2126 * r + 0.7152 * g + 0.0722 * b; };

const W = 760, X0 = 128, XA = 300, XB = 336, XC = 600, X1 = 654;
const TOP = 70, ISL = 26, LANE = 18, PITCH = ISL + LANE;
const FY = TOP - 8, FH = T.jalur.length * PITCH + 8;           // bingkai terminal
const YB = TOP + T.jalur.length * PITCH;                      // tepi bawah jalur terakhir
const YD = YB + 18;                                           // baris pintu bawah
const H = YB + 132;
const MID = TOP + 3 * PITCH - 10;

const rows = T.jalur.map((j, k) => {
  const y = TOP + k * PITCH;
  let x = XB + 6;
  const badges = routesForStop(j.stop, services, lookup).map(r => {
    const t = routeLabel(r), w = 10 + t.length * 7.6;
    const b = { x, w, t, slug: r.slug, name: r.route_name, color: r.route_color || "#334155", on: lum(r.route_color) > 0.6 ? "#161e2b" : "#fff" };
    x += w + 4;
    return b;
  });
  return { ...j, y, badges, here: j.stop === current };
});
const doors = T.doors.map(d => {
  const y = d.side === "top" ? FY - 34 : YD;
  const cx = d.x, cy = y + 10;
  const arrow = d.from === "left" ? [cx - 34, cy, cx - 13, cy] : d.from === "right" ? [cx + 34, cy, cx + 13, cy]
    : d.from === "below" ? [cx, cy + 34, cx, cy + 13] : [cx, cy - 34, cx, cy - 13];
  return { ...d, y, cx, arrow };
});
const stair = (x, y, up) => ({ x, y, up });
const r1 = v => Math.round(v * 10) / 10;
---
<figure class="td" id="denah-terminal">
  <div class="td-scroll">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-labelledby="td-title td-desc">
      <title id="td-title">Denah {T.name}</title>
      <desc id="td-desc">{rows.map(r => `Jalur ${r.n}: ${r.badges.map(b => b.t).join(", ") || "tidak ada rute"}`).join(". ")}.</desc>
      <defs>
        <marker id="td-ag" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="4" markerHeight="4" orient="auto"><path d="M0,0L10,5L0,10z" class="td-in" /></marker>
        <marker id="td-ar" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="4" markerHeight="4" orient="auto"><path d="M0,0L10,5L0,10z" class="td-out" /></marker>
        <marker id="td-ad" viewBox="0 0 10 10" refX="7" refY="5" markerWidth="3.6" markerHeight="3.6" orient="auto"><path d="M0,0L10,5L0,10z" class="td-door-a" /></marker>
        <symbol id="td-st-dn" viewBox="0 0 20 20"><rect x="1" y="1" width="18" height="18" rx="4" class="td-ic-bg" /><path d="M3.5,16h4v-3.5h4v-3.5h4v-3.5" class="td-ic" /><path d="M10,4.5l-5,5m0,-4v4h4" class="td-ic" /></symbol>
        <symbol id="td-st-up" viewBox="0 0 20 20"><rect x="1" y="1" width="18" height="18" rx="4" class="td-ic-bg" /><path d="M3.5,16h4v-3.5h4v-3.5h4v-3.5" class="td-ic" /><path d="M5,9.5l5,-5m-4,0h4v4" class="td-ic" /></symbol>
      </defs>
      <rect class="td-frame" x={X0 - 24} y={FY} width={X1 - X0 + 48} height={FH} rx="14" />
      {rows.map(r => (
        <g class={`td-row${r.here ? " is-here" : ""}`}>
          <rect class="td-isl" x={X0 + 22} y={r.y} width={X1 - X0 - 30} height={ISL} rx="8" />
          <rect class="td-lane" x={X0 - 24} y={r.y + ISL} width={X1 - X0 + 48} height={LANE} />
          {[250, 520].map(ax => <path class="td-flow" d={`M${ax},${r.y + ISL + LANE / 2}h12m-4,-3.5l4,3.5l-4,3.5`} />)}
          <use href="#td-st-dn" class="td-dn" x={XA} y={r.y + 3} width="20" height="20" />
          <use href="#td-st-up" class="td-up" x={XC + 8} y={r.y + 3} width="20" height="20" />
          <a href={`/halte/${r.stop}`}><title>{`Halte ${T.name.replace(/^Terminal /, "")} Jalur ${r.n}`}</title>
            <rect class="td-jl" x={X0 - 18} y={r.y + 3} width="56" height={ISL - 6} rx="10" />
            <text class="td-jl-t" x={X0 + 10} y={r.y + ISL / 2 + 4.3}>Jalur {r.n}</text>
          </a>
          {r.badges.map(b => (
            <a href={`/rute/${b.slug}`}><title>{`${b.t} · ${b.name}`}</title>
              <rect x={r1(b.x)} y={r.y + 3} width={r1(b.w)} height={ISL - 6} rx="5" fill={b.color} />
              <text class="td-b" x={r1(b.x + b.w / 2)} y={r.y + ISL / 2 + 4.3} fill={b.on}>{b.t}</text>
            </a>
          ))}
        </g>
      ))}
      <text class="td-road" x="330" y={FY - 20}>{T.road}</text>
      {doors.map(d => (
        <g class="td-door">
          <path class="td-door-l" d={`M${d.arrow[0]},${d.arrow[1]}L${d.arrow[2]},${d.arrow[3]}`} marker-end="url(#td-ad)" />
          <rect x={d.cx - 10} y={d.y} width="20" height="20" rx="2" />
          <text x={d.cx} y={d.y + 14.5}>{d.n}</text>
        </g>
      ))}
      {doors.filter(d => d.label).map(d => <text class="td-lab" x={d.labelX ?? d.cx} y={YD + 66}>{d.label}</text>)}
      <path class="td-in-l" d={`M8,${MID}H${X0 - 30}`} marker-end="url(#td-ag)" />
      <text class="td-in-t" x="8" y={MID - 10}>Bus masuk</text>
      {T.busIn.split(/(?<=Jl\.) /).map((s, i) => <text class="td-sub" x="8" y={MID + 20 + i * 13}>{s}</text>)}
      <path class="td-out-l" d={`M${X1 + 30},${MID}H${W - 8}`} marker-end="url(#td-ar)" />
      <text class="td-out-t" x={W - 8} y={MID - 10}>Bus keluar</text>
      {T.busOut.split(/(?<=Sultan) /).map((s, i) => <text class="td-sub is-end" x={W - 8} y={MID + 20 + i * 13}>{s}</text>)}
      <text class="td-walk" x="8" y={H - 22}>{T.walk}</text>
    </svg>
  </div>
  <figcaption class="lm-legend td-legend">
    <span class="mm-item"><svg class="td-key" viewBox="0 0 20 20"><use href="#td-st-dn" class="td-dn" /></svg>tangga turun (penumpang tiba)</span>
    <span class="mm-item"><svg class="td-key" viewBox="0 0 20 20"><use href="#td-st-up" class="td-up" /></svg>tangga naik (penumpang berangkat)</span>
    <span class="mm-item"><span class="td-door-key">1</span>pintu masuk, panah = arah masuk</span>
    <span class="td-note">{T.note}</span>
  </figcaption>
</figure>
