---
import { ogSpecs } from "../lib/og-pages.js";
import { ROUTE_CATEGORIES, loadRoutesIndex, categoryOf } from "../lib/data.js";
const usedCats = new Set(loadRoutesIndex().map(categoryOf));
const footerCats = ROUTE_CATEGORIES.filter(c => usedCats.has(c.key));
const CONTACT_EMAIL = "tahujalanteam@gmail.com";
const { title, description, canonicalPath = "/", crumbs = null, schema = null } = Astro.props;
const path = Astro.url.pathname;
const isActive = (p) => (p === "/" ? path === "/" : path === p || path.startsWith(p + "/"));
const siteUrl = Astro.site ? Astro.site.toString().replace(/\/$/, "") : "";
const canonicalUrl = `${siteUrl}${canonicalPath}`;
// Gambar pratinjau tautan: dicocokkan otomatis dari path halaman (lihat src/lib/og-pages.js)
const ogKey = canonicalPath.replace(/^\/|\/$/g, "");
const ogImageUrl = `${siteUrl}${ogSpecs().has(ogKey) ? `/og/${ogKey}.png` : "/og/umum.png"}`;
// Data terstruktur (JSON-LD) untuk Google: breadcrumb (crumbs = [{ name, path }]) + skema halaman (schema).
// Dibuat saat build dari data yang sama dengan isi halaman; tidak ada data tambahan yang perlu dirawat.
const abs = p => (p && /^https?:/.test(p) ? p : `${siteUrl}${p || ""}`);
const ldGraph = [];
if (canonicalPath === "/") {
  ldGraph.push(
    { "@type": "WebSite", "@id": `${siteUrl}/#website`, name: "halte.id", url: `${siteUrl}/`, inLanguage: "id-ID", publisher: { "@id": `${siteUrl}/#org` } },
    { "@type": "Organization", "@id": `${siteUrl}/#org`, name: "halte.id", url: `${siteUrl}/`, logo: `${siteUrl}/icon-512.png`, email: CONTACT_EMAIL },
  );
}
if (crumbs && crumbs.length) {
  const list = [{ name: "Beranda", path: "/" }, ...crumbs];
  ldGraph.push({
    "@type": "BreadcrumbList",
    itemListElement: list.map((c, i) => ({ "@type": "ListItem", position: i + 1, name: c.name, item: abs(c.path || canonicalPath) })),
  });
}
for (const node of [schema].flat().filter(Boolean)) ldGraph.push({ url: canonicalUrl, ...node });
const jsonLd = ldGraph.length ? JSON.stringify({ "@context": "https://schema.org", "@graph": ldGraph }).replace(/</g, "\\u003c") : null;
const pageTitle = title ? `${title} | halte.id` : "halte.id — Panduan Bus & Kereta Jakarta dan Jabodetabek";
const pageDescription = description || "Panduan bus dan kereta Jakarta: rute dan halte Transjakarta & Mikrotrans, stasiun KRL, MRT, dan LRT, jadwal, tarif, dan titik transit.";
---
<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={pageTitle} />
    <meta property="og:site_name" content="halte.id" />
    <meta property="og:locale" content="id_ID" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImageUrl} />
    {jsonLd && <script type="application/ld+json" set:html={jsonLd} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-48.png" type="image/png" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#2652d9" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0a0e15" media="(prefers-color-scheme: dark)" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap" rel="stylesheet" />
    <script is:inline>
      try {
        var t = localStorage.getItem("theme");
        if (!t) t = matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        document.documentElement.setAttribute("data-theme", t);
      } catch (e) {}
    </script>
    <style is:global>
      /* Palet halte.id — "kertas & tinta" (terang) dan "malam kota" (gelap) */
      :root {
        --bg-color: #f4f4f0; --card-bg: #ffffff; --card-raised: #fbfbf9;
        --primary: #2652d9; --primary-dark: #1b3fae;
        --text-main: #161e2b; --text-sub: #5c6575; --border-color: #e3e3dc; --badge-bg: #eeeee8;
        --brt-bg: #e4ebfd; --brt-fg: #1d43b5;
        --muted: #6b7381; --muted-2: #a2a8b2;
        --warn: #b86e00; --warn-bg: #fbf1dc; --warn-border: #f0d6a1;
        --danger: #c8372d; --success: #18885a;
        --pin-main: #2652d9; --pin-muted: #6b7381;
        --acc-orange: #cf5f1a; --acc-green: #18885a; --acc-violet: #6a4bd6; --acc-teal: #10808e; --acc-red: #c8372d;
        --radius: 22px;
        --shadow: 0 1px 2px rgba(22,30,43,.05), 0 8px 24px -14px rgba(22,30,43,.18);
        --shadow-hover: 0 2px 4px rgba(22,30,43,.06), 0 16px 32px -14px rgba(22,30,43,.26);
        --glow-a: #dfe6fb; --glow-b: #f8ecd6; --header-bg: rgba(255,255,255,.84);
        --font-head: "Plus Jakarta Sans", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      }
      [data-theme="dark"] {
        --bg-color: #0a0e15; --card-bg: #121924; --card-raised: #18212e;
        --primary: #6c93ff; --primary-dark: #4f77ec;
        --text-main: #e6eaf1; --text-sub: #96a0b1; --border-color: #222c3a; --badge-bg: #1b2432;
        --brt-bg: #17254a; --brt-fg: #a9bfff;
        --muted: #7d8798; --muted-2: #56606f;
        --warn: #f0b552; --warn-bg: #2a2111; --warn-border: #4a3a17;
        --danger: #ff7a6e; --success: #4fd39a;
        --acc-orange: #ff9b5c; --acc-green: #4fd39a; --acc-violet: #ab93ff; --acc-teal: #52cbd8; --acc-red: #ff7a6e;
        --shadow: inset 0 1px 0 rgba(255,255,255,.045), 0 10px 28px -18px rgba(0,0,0,.8);
        --shadow-hover: inset 0 1px 0 rgba(255,255,255,.07), 0 18px 36px -18px rgba(0,0,0,.9);
        --glow-a: #111c3a; --glow-b: #0e1424; --header-bg: rgba(10,14,21,.82);
        color-scheme: dark;
      }
      * { box-sizing: border-box; }
      [hidden] { display: none !important; }
      body { margin: 0; font-family: var(--font-head); font-weight: 500;
        color: var(--text-main); line-height: 1.55;
        background: radial-gradient(900px 420px at 88% -8%, var(--glow-a) 0%, transparent 62%),
                    radial-gradient(700px 360px at -8% 0%, var(--glow-b) 0%, transparent 58%),
                    var(--bg-color); background-repeat: no-repeat; }
      button, input { font-family: inherit; }
      a { color: var(--primary); text-decoration: none; }
      a:hover { text-decoration: underline; }
      .container { max-width: 880px; margin: 0 auto; padding: 0 1.25rem; }
      header.site { background: var(--header-bg); -webkit-backdrop-filter: saturate(1.4) blur(10px); backdrop-filter: saturate(1.4) blur(10px); border-bottom: 1px solid var(--border-color); position: sticky; top: 0; z-index: 10; }
      header.site .container { display: flex; align-items: center; justify-content: space-between; height: 60px; }
      header.site a.logo { color: var(--text-main); font-weight: 800; font-size: 1.2rem; letter-spacing: -0.03em; display: inline-flex; align-items: center; gap: 0.5rem; }
      header.site a.logo:hover { text-decoration: none; }
      .logo-mark { width: 28px; height: 28px; border-radius: 9px; background: var(--primary); color: #fff; display: grid; place-items: center; }
      .logo-mark svg { width: 18px; height: 18px; }
      header.site a.logo .tld { color: var(--primary); }
      nav.site { display: flex; align-items: center; gap: 1.1rem; font-size: 0.9rem; }
      nav.site a { color: var(--text-sub); font-weight: 500; }
      nav.site a:hover { color: var(--primary); text-decoration: none; }
      nav.site a[aria-current="page"] { color: var(--text-main); font-weight: 700; }
      #theme-toggle { border: 1px solid var(--border-color); background: var(--card-bg); color: var(--text-main);
        border-radius: 999px; width: 36px; height: 36px; cursor: pointer; font-size: 1rem; }
      main { padding: 1.75rem 0 3rem; min-height: 60vh; }
      footer.site { border-top: 1px solid var(--border-color); background: color-mix(in srgb, var(--card-bg) 55%, var(--bg-color)); padding: 2.4rem 0 1.2rem; font-size: 0.88rem; color: var(--text-sub); margin-top: 2rem; }
      .footer-grid { display: grid; grid-template-columns: 1.6fr 1fr 1fr 1fr; gap: 2rem; }
      .f-brand .logo { color: var(--text-main); font-weight: 800; font-size: 1.15rem; letter-spacing: -0.03em; display: inline-flex; align-items: center; gap: .5rem; }
      .f-brand .logo:hover { text-decoration: none; }
      .f-brand .logo .tld { color: var(--primary); }
      .f-brand p { margin: .7rem 0 1rem; max-width: 340px; line-height: 1.55; }
      .f-cta { display: inline-flex; align-items: center; gap: .45rem; padding: .5rem .9rem; border-radius: 12px; font-weight: 700; font-size: .85rem;
        color: var(--primary); background: color-mix(in srgb, var(--primary) 10%, transparent); border: 1px solid color-mix(in srgb, var(--primary) 25%, transparent); }
      .f-cta:hover { text-decoration: none; background: color-mix(in srgb, var(--primary) 16%, transparent); }
      .f-cta svg { width: 17px; height: 17px; }
      .f-col { display: flex; flex-direction: column; gap: .55rem; }
      .f-col h2 { margin: 0 0 .3rem; font-size: .78rem; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; color: var(--text-main); }
      .f-col a { color: var(--text-sub); font-weight: 500; }
      .f-col a:hover { color: var(--primary); text-decoration: none; }
      .f-bottom { position: relative; display: flex; flex-wrap: wrap; justify-content: space-between; gap: .4rem 1.5rem; margin-top: 2rem; padding-top: 1.1rem; font-size: .78rem; }
      .f-bottom::before { content: ""; position: absolute; top: 0; left: 1.25rem; right: 1.25rem; border-top: 1px solid var(--border-color); }
      @media (max-width: 760px) {
        .footer-grid { grid-template-columns: 1fr 1fr; gap: 1.6rem 1.2rem; }
        .f-brand { grid-column: 1 / -1; }
      }
      h1 { font-size: 1.7rem; font-weight: 800; letter-spacing: -0.025em; line-height: 1.2; margin: 0 0 0.5rem; }
      h2 { font-size: 1.12rem; font-weight: 800; letter-spacing: -0.015em; margin: 2rem 0 0.75rem; }
      .crumb { font-size: 0.85rem; color: var(--text-sub); margin-bottom: 0.75rem; }
      .badge-bus { display: inline-flex; align-items: center; justify-content: center; flex: none; min-width: 2.9rem; height: 2.3rem;
        font-weight: 800; font-size: 0.95rem; letter-spacing: -0.01em; padding: 0 0.6rem; border-radius: 11px;
        background: var(--c, #334155); color: var(--on, #fff); box-shadow: inset 0 -2px 0 rgba(0,0,0,.14); }
      .badge-sub { display: inline-block; font-size: 0.7rem; font-weight: 600; color: #fff;
        padding: 0.1rem 0.45rem; border-radius: 8px; margin: 0 0.25rem 0.25rem 0; }
      .badge-sub:hover { text-decoration: none; opacity: 0.85; }
      .badge-more { background: var(--badge-bg); color: var(--text-sub); }
      .card { display: flex; align-items: center; gap: 0.75rem; background: var(--card-bg); border: 1px solid var(--border-color);
        border-radius: var(--radius); padding: 0.9rem 1.2rem; margin-bottom: 0.7rem; color: var(--text-main); box-shadow: var(--shadow);
        transition: transform .15s ease, box-shadow .15s ease, border-color .15s ease; }
      a.card:hover { text-decoration: none; border-color: var(--c, var(--primary)); transform: translateY(-2px); box-shadow: var(--shadow-hover); }
      .card .sub { font-size: 0.85rem; color: var(--text-sub); }
      .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); gap: 0.7rem; }
      .grid .card { margin: 0; }
      .route-meta-card { display: flex; flex-wrap: wrap; gap: 1.5rem; background: var(--card-bg); border: 1px solid var(--border-color);
        border-radius: var(--radius); padding: 1rem 1.4rem; margin: 1rem 0 1.5rem; justify-content: space-around; }
      .meta-item { font-size: 0.9rem; color: var(--text-sub); display: flex; flex-direction: column; align-items: center; justify-content: center; }
      .meta-item b { display: block; color: var(--text-main); font-size: 1rem; }
      .meta-icon { width: 16px; height: 16px; stroke: var(--text-sub); margin-bottom: 4px;}
      .dir-card { background: var(--card-bg); border: 1px solid var(--border-color); border-radius: var(--radius);
        padding: 1.2rem 1.4rem; margin-bottom: 1.5rem; box-shadow: var(--shadow); }
      .dir-card h2 { margin-top: 0; }
      .route-map { width: 100%; height: auto; border-radius: 16px; border: 1px solid var(--border-color); margin-bottom: 1rem; }
      /* Timeline: garis per-item (seperti desain lama) supaya berhenti tepat di titik halte pertama & terakhir */
      .timeline { position: relative; list-style: none; margin: 0; padding: 0 0 0 24px; display: flex; flex-direction: column; }
      .stop-item { position: relative; padding: 0 0 18px; }
      .stop-item::before { content: ""; position: absolute; left: -17px; top: 0; bottom: 0; width: 4px;
        background-color: var(--route-color, var(--primary)); z-index: 1; }
      .stop-item:first-child::before { top: 10px; }
      .stop-item:last-child::before { bottom: calc(100% - 10px); }
      .stop-item:last-child { padding-bottom: 0; }
      .stop-dot-brt { position: absolute; left: -22px; top: 3px; width: 14px; height: 14px; border-radius: 50%;
        background-color: var(--card-bg); border: 4px solid var(--route-color, var(--primary)); z-index: 2; }
      .stop-dot-nonbrt { position: absolute; left: -16px; top: 8px; width: 10px; height: 4px; border-radius: 2px;
        background-color: var(--route-color, var(--primary)); z-index: 2; }
      .stop-item.is-nonbrt-item:first-child .stop-dot-nonbrt,
      .stop-item.is-nonbrt-item:last-child .stop-dot-nonbrt { top: 8px; left: -24px; width: 18px; }
      .stop-list-name { display: block; font-size: 0.95rem; line-height: 20px; margin-bottom: 4px; font-weight: 600; color: var(--text-main); }
      .stop-list-name:hover { color: var(--primary); text-decoration: none; }
      .stop-hero { background: var(--card-bg); border: 1px solid var(--border-color); border-radius: var(--radius); padding: 1.3rem 1.5rem; margin-bottom: 1rem; box-shadow: var(--shadow); }
      .type-pill { display: inline-block; font-size: 0.72rem; font-weight: 700; letter-spacing: .02em; padding: 0.2rem 0.6rem; border-radius: 999px; background: var(--badge-bg); color: var(--text-sub); }
      .type-pill.is-brt { background: var(--brt-bg); color: var(--brt-fg); }
      .search-input { width: 100%; max-width: 520px; padding: 0.75rem 1.1rem; border: 1px solid var(--border-color); border-radius: 999px;
        font-size: 1rem; background: var(--card-bg); color: var(--text-main); margin: 1rem 0; }
      .search-input:focus { outline: 2px solid var(--primary); border-color: transparent; }
      .results { list-style: none; padding: 0; margin: 0 0 1.5rem; max-width: 520px; background: var(--card-bg); border-radius: 16px; }
      .results li { border-bottom: 1px solid var(--border-color); }
      .results a { display: block; padding: 0.6rem 1rem; color: var(--text-main); }
      .lead { color: var(--text-sub); max-width: 640px; }
      /* Hero rute: warna rute jadi tokoh utama */
      .route-hero { position: relative; overflow: hidden; border-radius: 26px; padding: 1.4rem 1.5rem 1.2rem; margin: 0.25rem 0 1.5rem;
        color: var(--on, #fff); background: linear-gradient(135deg, var(--c) 0%, color-mix(in srgb, var(--c) 78%, #000) 100%);
        box-shadow: 0 18px 36px -18px var(--c); }
      .hero-line { position: absolute; right: 0; top: 0; height: 100%; width: 62%; opacity: .16; pointer-events: none; color: var(--on); }
      .hero-main { position: relative; display: flex; align-items: center; gap: 1rem; }
      .hero-badge { flex: none; min-width: 4.2rem; height: 4.2rem; padding: 0 0.7rem; display: grid; place-items: center; border-radius: 18px;
        background: var(--on); color: var(--c); font-weight: 800; font-size: 1.75rem; letter-spacing: -0.03em; box-shadow: 0 6px 16px -6px rgba(0,0,0,.35); }
      .hero-text { min-width: 0; }
      .hero-kicker { margin: 0; font-size: 0.72rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; opacity: .8; }
      .route-hero h1 { margin: 0.1rem 0 0; font-size: 1.55rem; color: inherit; }
      .hero-sub { margin: 0.15rem 0 0; font-size: 0.92rem; opacity: .88; }
      .hero-chips { position: relative; display: flex; flex-wrap: wrap; gap: 0.5rem; list-style: none; padding: 0; margin: 1.1rem 0 0; }
      .hero-chips li { display: inline-flex; align-items: center; gap: 0.4rem; font-size: 0.82rem; font-weight: 600; padding: 0.35rem 0.75rem;
        border-radius: 999px; background: color-mix(in srgb, var(--on) 16%, transparent); border: 1px solid color-mix(in srgb, var(--on) 26%, transparent); }
      .hero-chips svg { width: 15px; height: 15px; flex: none; }
      @media (max-width: 640px) { .route-hero { padding: 1.2rem 1.1rem 1rem; border-radius: 22px; } .hero-badge { min-width: 3.4rem; height: 3.4rem; font-size: 1.4rem; border-radius: 15px; } .route-hero h1 { font-size: 1.25rem; } }
      /* ===== Landing ===== */
      .home-hero { position: relative; margin: 0 0 2rem; padding: 2.4rem 2rem 1.8rem; border-radius: 30px;
        background: var(--card-bg); border: 1px solid var(--border-color); box-shadow: var(--shadow); }
      .home-lines-wrap { position: absolute; inset: 0; overflow: hidden; border-radius: inherit; pointer-events: none; }
      .home-lines { position: absolute; right: 0; top: 0; height: 100%; width: 55%; opacity: .9; pointer-events: none;
        -webkit-mask-image: linear-gradient(to left, #000 40%, transparent 78%); mask-image: linear-gradient(to left, #000 40%, transparent 78%); }
      .home-lines path { fill: none; stroke-width: 9; stroke-linecap: round; stroke-linejoin: round; opacity: .55; }
      .home-lines circle { fill: var(--card-bg); stroke: var(--text-main); stroke-width: 4; opacity: .7; }
      .home-hero-inner { position: relative; max-width: 560px; }
      .home-kicker { display: inline-flex; align-items: center; gap: .5rem; margin: 0 0 .9rem; padding: .3rem .8rem; border-radius: 999px;
        font-size: .75rem; font-weight: 700; color: var(--text-sub); background: var(--bg-color); border: 1px solid var(--border-color); }
      .home-kicker .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--success); box-shadow: 0 0 0 3px color-mix(in srgb, var(--success) 22%, transparent); }
      .home-hero h1 { font-size: clamp(1.9rem, 5vw, 2.7rem); line-height: 1.08; letter-spacing: -0.035em; margin: 0 0 .7rem; }
      .home-hero .hl { color: var(--primary); position: relative; white-space: nowrap; }
      .home-lead { color: var(--text-sub); margin: 0 0 1.4rem; font-size: 1.02rem; max-width: 480px; }
      .home-lead a { font-weight: 700; }
      .lead-more { display: block; margin-top: .35rem; }
      .home-search { position: relative; max-width: 520px; }
      .home-search > svg { position: absolute; left: 18px; top: 50%; width: 20px; height: 20px; transform: translateY(-50%); color: var(--text-sub); pointer-events: none; }
      .home-search input { width: 100%; height: 56px; padding: 0 1.2rem 0 3rem; font-size: 1.02rem; font-weight: 600; color: var(--text-main);
        background: var(--card-bg); border: 2px solid var(--border-color); border-radius: 18px; box-shadow: 0 10px 24px -14px color-mix(in srgb, var(--primary) 45%, transparent); transition: border-color .15s; }
      .home-search input::placeholder { color: var(--text-sub); font-weight: 500; }
      .home-search input:focus { outline: none; border-color: var(--primary); }
      .home-results { position: absolute; z-index: 15; left: 0; right: 0; top: calc(100% + 8px); list-style: none; margin: 0; padding: .35rem;
        background: var(--card-bg); border: 1px solid var(--border-color); border-radius: 18px; box-shadow: var(--shadow-hover); max-height: 420px; overflow: auto; }
      .home-results a { display: flex; align-items: center; gap: .75rem; padding: .5rem .6rem; border-radius: 12px; color: var(--text-main); }
      .home-results a:hover, .home-results a:focus { background: var(--bg-color); text-decoration: none; outline: none; }
      .home-results .badge-bus { min-width: 2.5rem; height: 2rem; font-size: .85rem; border-radius: 9px; }
      .home-results .empty { padding: .8rem; color: var(--text-sub); font-size: .9rem; }
      .res-pin { flex: none; width: 2.5rem; height: 2rem; display: grid; place-items: center; border-radius: 9px; background: var(--badge-bg); color: var(--text-sub); }
      .res-pin.is-brt { background: var(--brt-bg); color: var(--brt-fg); }
      .res-pin svg { width: 16px; height: 16px; }
      .res-text { display: flex; flex-direction: column; min-width: 0; line-height: 1.25; }
      .res-text b { font-weight: 700; font-size: .95rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
      .res-text small { color: var(--text-sub); font-size: .75rem; }
      .home-stats { display: flex; flex-wrap: wrap; gap: .5rem 1.4rem; margin-top: 1.1rem; font-size: .9rem; }
      .home-stats a { color: var(--text-sub); }
      .home-stats b { color: var(--text-main); font-weight: 800; }
      .home-section { margin: 0 0 2rem; }
      .section-head { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; margin-bottom: .8rem; }
      .section-head h2 { margin: 0; }
