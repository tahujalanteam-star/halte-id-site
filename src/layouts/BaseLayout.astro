      .locate-main svg { width: 20px; height: 20px; }
      .locate-main:disabled { opacity: .6; cursor: wait; }
      .privacy-note { font-size: .8rem; color: var(--text-sub); margin: .7rem 0 0; }
      .locate-status { margin: 0 0 1.4rem; padding: .8rem 1rem; border-radius: 14px; font-size: .9rem; background: color-mix(in srgb, var(--primary) 8%, var(--card-bg)); border: 1px solid color-mix(in srgb, var(--primary) 25%, transparent); }
      .locate-status.is-error { background: color-mix(in srgb, var(--danger) 9%, var(--card-bg)); border-color: color-mix(in srgb, var(--danger) 32%, transparent); }
      .locate-status.is-warn { background: var(--warn-bg); border-color: var(--warn-border); }
      #results { margin-bottom: 2rem; scroll-margin-top: 76px; }
      #results .map-toggle { margin-bottom: 1rem; }
      .nearest-card .near-top { color: var(--text-main); }
      .nearest-card .near-top:hover { text-decoration: none; color: var(--primary); }
      .nearest-actions { display: flex; flex-wrap: wrap; gap: .4rem 1rem; font-size: .8rem; font-weight: 700; padding-top: .15rem; }
      .routes-near-title { margin-top: 2rem; }
      @media (max-width: 640px) {
        .home-search-row { flex-direction: column; }
        .locate-btn { height: 52px; }
      }
      /* ===== Penyesuaian mode gelap ===== */
      [data-theme="dark"] .badge-bus, [data-theme="dark"] .corridor-num, [data-theme="dark"] .hero-badge {
        box-shadow: inset 0 -2px 0 rgba(0,0,0,.18), 0 0 0 1px rgba(255,255,255,.16); }
      [data-theme="dark"] .corridor { border-top-color: color-mix(in srgb, var(--c) 78%, #fff); }
      [data-theme="dark"] .home-lines { opacity: .8; filter: saturate(1.25) brightness(1.45); }
      [data-theme="dark"] .home-lines path { opacity: .5; stroke-width: 7; }
      [data-theme="dark"] .home-lines circle { fill: var(--card-bg); stroke: var(--text-sub); }
      [data-theme="dark"] .route-hero { background: linear-gradient(135deg, color-mix(in srgb, var(--c) 88%, #fff) 0%, var(--c) 100%);
        box-shadow: 0 0 0 1px rgba(255,255,255,.06), 0 22px 44px -26px var(--c); }
      [data-theme="dark"] .card, [data-theme="dark"] .dir-card, [data-theme="dark"] .route-ctx, [data-theme="dark"] .near-card,
      [data-theme="dark"] .feature, [data-theme="dark"] .service-card, [data-theme="dark"] .topic-card, [data-theme="dark"] .area-route { background: var(--card-bg); }
      [data-theme="dark"] a.card:hover, [data-theme="dark"] .near-card:hover, [data-theme="dark"] .feature:hover, [data-theme="dark"] .service-card:hover { background: var(--card-raised); }
      [data-theme="dark"] .cta-card { background: linear-gradient(135deg, #2b4fc4, #1a3088); }
      [data-theme="dark"] .mini-map img { filter: none; }
      /* Garis rute berwarna gelap tetap terlihat di latar gelap */
      [data-theme="dark"] .stop-item::before, [data-theme="dark"] .stop-dot-nonbrt { background-color: color-mix(in srgb, var(--route-color, var(--primary)) 72%, #fff); }
      [data-theme="dark"] .stop-dot-brt { border-color: color-mix(in srgb, var(--route-color, var(--primary)) 72%, #fff); }
      /* Ikon tombol tema */
      #theme-toggle { display: grid; place-items: center; }
      #theme-toggle svg { width: 18px; height: 18px; }
      #theme-toggle .ic-sun { display: none; }
      [data-theme="dark"] #theme-toggle .ic-sun { display: block; }
      [data-theme="dark"] #theme-toggle .ic-moon { display: none; }
      /* Mobile: header ringkas + bottom tab bar */
      .tabbar { display: none; }
      @media (max-width: 640px) {
        nav.site a { display: none; }
        .tabbar { display: grid; grid-template-columns: repeat(4, 1fr); position: fixed; left: 0; right: 0; bottom: 0; z-index: 20;
          background: var(--card-bg); border-top: 1px solid var(--border-color); padding-bottom: env(safe-area-inset-bottom); }
        .tabbar a { display: flex; flex-direction: column; align-items: center; gap: 2px; padding: 8px 0 7px;
          color: var(--text-sub); font-size: 0.7rem; font-weight: 600; }
        .tabbar a:hover { text-decoration: none; }
        .tabbar a[aria-current="page"] { color: var(--primary); }
        .tabbar svg { width: 22px; height: 22px; }
        body { padding-bottom: calc(60px + env(safe-area-inset-bottom)); }
      }
    </style>
  </head>
  <body>
    <header class="site">
      <div class="container">
        <a class="logo" href="/"><span class="logo-mark" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M3 17c4 0 4-10 9-10s5 10 9 10"/><circle cx="12" cy="7" r="1.6" fill="currentColor"/></svg></span><span>halte<span class="tld">.id</span></span></a>
        <nav class="site">
          <a href="/halte" aria-current={isActive("/halte") || isActive("/terdekat") ? "page" : undefined}>Halte</a>
          <a href="/rute" aria-current={isActive("/rute") ? "page" : undefined}>Bus</a>
          <a href="/kereta" aria-current={isActive("/kereta") || isActive("/stasiun") ? "page" : undefined}>Kereta</a>
          <a href="/tentang" aria-current={isActive("/tentang") ? "page" : undefined}>Tentang</a>
          <button id="theme-toggle" type="button" aria-label="Ganti tema terang/gelap" title="Ganti tema">
            <svg class="ic-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.5 14.5A8.5 8.5 0 0 1 9.5 3.5a8.5 8.5 0 1 0 11 11Z"/></svg>
            <svg class="ic-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
          </button>
        </nav>
      </div>
    </header>
    <main><div class="container"><slot /></div></main>
    <footer class="site">
      <div class="container footer-grid">
        <div class="f-brand">
          <a class="logo" href="/" aria-label="halte.id beranda"><span class="logo-mark" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M3 17c4 0 4-10 9-10s5 10 9 10"/><circle cx="12" cy="7" r="1.6" fill="currentColor"/></svg></span><span>halte<span class="tld">.id</span></span></a>
          <p>Panduan bus dan kereta Jakarta: rute dan halte Transjakarta, lin KRL, MRT, dan LRT, titik transit, halte terdekat, dan rute menuju tempat populer.</p>
          <a href="/terdekat?cari=1" class="f-cta">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="3.5"/><path d="M12 2v3M12 19v3M2 12h3M19 12h3"/><circle cx="12" cy="12" r="8"/></svg>
            Cari halte terdekat
          </a>
        </div>
        <nav class="f-col" aria-label="Jelajahi">
          <h2>Jelajahi</h2>
          <a href="/rute">Daftar Rute</a>
          <a href="/halte">Daftar Halte</a>
          <a href="/terdekat">Halte Terdekat</a>
          <a href="/kawasan">Kawasan Transit</a>
          <a href="/tempat">Tempat &amp; Gedung</a>
          <a href="/stasiun">Stasiun Kereta</a>
          <a href="/kereta">Lin Kereta</a>
          <a href="/kereta/tarif">Kalkulator Tarif Kereta</a>
        </nav>
        <nav class="f-col" aria-label="Jenis layanan">
          <h2>Jenis Layanan</h2>
          {footerCats.map(c => <a href={`/rute#${c.key}`}>{c.label}</a>)}
        </nav>
        <nav class="f-col" aria-label="Informasi">
          <h2>Informasi</h2>
          <a href="/panduan">Panduan Naik Bus</a>
          <a href="/tentang">Tentang halte.id</a>
          <a href="/kebijakan-privasi">Kebijakan Privasi</a>
          <a href={`mailto:${CONTACT_EMAIL}?subject=Koreksi%20data%20halte.id`}>Laporkan Kesalahan Data</a>
        </nav>
      </div>
      <div class="container f-bottom">
        <span>&copy; {new Date().getFullYear()} halte.id. Tidak berafiliasi resmi dengan PT Transportasi Jakarta.</span>
        <span>Koordinat halte: GTFS Transjakarta · Stasiun &amp; peta: &copy; OpenStreetMap, &copy; Mapbox</span>
      </div>
    </footer>
    <nav class="tabbar" aria-label="Navigasi utama">
      <a href="/" aria-current={isActive("/") ? "page" : undefined}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m3 11 9-8 9 8"/><path d="M5 10v10h14V10"/></svg><span>Beranda</span></a>
      <a href="/halte" aria-current={isActive("/halte") ? "page" : undefined}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 10c0 6-8 12-8 12S4 16 4 10a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg><span>Halte</span></a>
      <a href="/rute" aria-current={isActive("/rute") ? "page" : undefined}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="3" width="16" height="14" rx="2"/><path d="M4 11h16"/><circle cx="8" cy="14" r="1"/><circle cx="16" cy="14" r="1"/><path d="M6 17v3M18 17v3"/></svg><span>Bus</span></a>
      <a href="/kereta" aria-current={isActive("/kereta") || isActive("/stasiun") ? "page" : undefined}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="5" y="3" width="14" height="14" rx="3"/><path d="M5 11h14"/><circle cx="9" cy="14" r=".9" fill="currentColor"/><circle cx="15" cy="14" r=".9" fill="currentColor"/><path d="m8 21 2-4M16 21l-2-4"/></svg><span>Kereta</span></a>
    </nav>
    <script is:inline>
      // Peta statis: pilih gaya Mapbox sesuai tema saat gambar pertama kali dimuat (tetap 1 gambar).
      window.mapSrcFor = function (img) {
        var dark = document.documentElement.getAttribute("data-theme") === "dark";
        return (dark && img.dataset.srcDark) || img.dataset.src;
      };
      document.querySelectorAll("img[data-src][data-autoload]").forEach(function (img) { img.src = window.mapSrcFor(img); });
      document.getElementById("theme-toggle").addEventListener("click", function () {
        var next = document.documentElement.getAttribute("data-theme") === "dark" ? "light" : "dark";
        document.documentElement.setAttribute("data-theme", next);
        try { localStorage.setItem("theme", next); } catch (e) {}
      });
    </script>
  </body>
</html>
