---
const { title, description, canonicalPath = "/" } = Astro.props;
const siteUrl = Astro.site ? Astro.site.toString().replace(/\/$/, "") : "";
const canonicalUrl = `${siteUrl}${canonicalPath}`;
const pageTitle = title ? `${title} | halte.id` : "halte.id — Panduan Rute & Halte Bus Jakarta";
const pageDescription = description || "Cari rute dan halte Transjakarta & JakLingko lengkap: jadwal, tarif, daftar pemberhentian, dan peta tiap koridor.";
---
<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta name="twitter:card" content="summary" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <style>
      :root {
        --ink: #0f172a;
        --ink-light: #475569;
        --accent: #d90429;
        --border: #e2e8f0;
        --bg: #f8fafc;
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
        color: var(--ink);
        background: var(--bg);
        line-height: 1.55;
      }
      a { color: var(--accent); text-decoration: none; }
      a:hover { text-decoration: underline; }
      .container { max-width: 960px; margin: 0 auto; padding: 0 1.25rem; }
      header.site { background: var(--ink); color: #fff; padding: 1rem 0; }
      header.site .container { display: flex; align-items: center; justify-content: space-between; }
      header.site a.logo { color: #fff; font-weight: 700; font-size: 1.1rem; }
      header.site a.logo span { color: var(--accent); }
      nav.site a { color: #cbd5e1; margin-left: 1.25rem; font-size: 0.9rem; }
      main { padding: 2rem 0 3rem; min-height: 60vh; }
      footer.site { border-top: 1px solid var(--border); padding: 1.5rem 0; font-size: 0.85rem; color: var(--ink-light); }
      footer.site a { color: var(--ink-light); margin-right: 1rem; }
      h1 { font-size: 1.6rem; margin: 0 0 0.5rem; }
      h2 { font-size: 1.15rem; margin: 2rem 0 0.75rem; }
      .badge {
        display: inline-flex; align-items: center; justify-content: center;
        font-size: 0.75rem; font-weight: 600; color: #fff;
        padding: 0.15rem 0.5rem; border-radius: 0.3rem; margin: 0 0.25rem 0.25rem 0;
      }
      .card { background: #fff; border: 1px solid var(--border); border-radius: 0.6rem; padding: 1rem 1.25rem; margin-bottom: 0.75rem; }
      .meta-row { display: flex; gap: 1.5rem; flex-wrap: wrap; color: var(--ink-light); font-size: 0.9rem; margin: 0.75rem 0 1.5rem; }
      ol.stop-list { list-style: none; margin: 0; padding: 0; border-left: 3px solid var(--border); }
      ol.stop-list li { position: relative; padding: 0.6rem 0 0.6rem 1.25rem; }
      ol.stop-list li::before {
        content: ""; position: absolute; left: -7px; top: 1.1rem;
        width: 11px; height: 11px; border-radius: 50%; background: #fff; border: 3px solid var(--accent);
      }
      ol.stop-list li a.stop-name { font-weight: 600; color: var(--ink); }
      ol.stop-list li a.stop-name:hover { color: var(--accent); }
    </style>
  </head>
  <body>
    <header class="site">
      <div class="container">
        <a class="logo" href="/">halte<span>.id</span></a>
        <nav class="site">
          <a href="/rute">Daftar Rute</a>
          <a href="/halte">Daftar Halte</a>
          <a href="/tentang">Tentang</a>
        </nav>
      </div>
    </header>
    <main>
      <div class="container">
        <slot />
      </div>
    </main>
    <footer class="site">
      <div class="container">
        <a href="/tentang">Tentang</a>
        <a href="/kebijakan-privasi">Kebijakan Privasi</a>
        <span>&copy; {new Date().getFullYear()} halte.id — Panduan rute & halte bus Jakarta, tidak berafiliasi resmi dengan Transjakarta.</span>
      </div>
    </footer>
  </body>
</html>
