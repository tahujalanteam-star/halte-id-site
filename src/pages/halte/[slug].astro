---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { placeCategoryLabel, badgeVars, groupByCategory, categoryOf, loadStops, loadRoutesIndex, loadStopServices, buildRouteLookup, routesForStop } from "../../lib/data.js";
import { stationsForStop, primaryMode, modeInfo, lineInfo } from "../../lib/rail.js";
import { routeContext, nearbyStops, placesNearStop, stopGroups, coordOf, distanceM, formatDistance, staticStopMap, compassDir } from "../../lib/stop-insights.js";

export async function getStaticPaths() {
  const stops = loadStops();
  return Object.keys(stops).map(stopId => ({
    params: { slug: stopId },
    props: { stopId },
  }));
}

const { stopId } = Astro.props;
const stops = loadStops();
const stop = stops[stopId];
const stopServices = loadStopServices();
const routeLookup = buildRouteLookup(loadRoutesIndex());
const serving = routesForStop(stopId, stopServices, routeLookup);
const typeLabel = stop.type === "brt" ? "Halte BRT" : "Halte Non-BRT";
const isBrt = stop.type === "brt";
const MODE = { mrt: { label: "MRT", color: "#db0000" }, lrt: { label: "LRT", color: "#c2185b" }, krl: { label: "KRL", color: "#db6300" }, kai: { label: "Kereta Bandara", color: "#1e3a8a" } };
// Stasiun kereta terdekat (otomatis dari koordinat) + transfer tercatat di stops.json
const rail = stationsForStop(stopId).map(s => ({ ...s, mode: modeInfo(primaryMode(s)) }));
const modeMap = new Map();
(stop.transfers || []).map(t => MODE[t.type]).filter(Boolean).forEach(m => modeMap.set(m.label, m));
rail.forEach(s => { if (!modeMap.has(s.mode.short)) modeMap.set(s.mode.short, { label: s.mode.short, color: s.mode.color }); });
const modes = [...modeMap.values()];
const groups = groupByCategory(serving);
const nameOf = id => stops[id]?.name || id;

// Konteks sebelum/sesudah per rute & arah
const ctx = routeContext(stopId);
// Satu baris per arah, dibaca kiri → kanan searah laju bus:
// [┄ N halte] [sebelumnya] [KAMU DI SINI] ▶ [berikutnya] [┄ N halte] [halte akhir]
function trackFor(o) {
  const node = (id, state, role) => ({ kind: "node", id, name: nameOf(id), state, role });
  const items = [];
  if (o.pos > 0) {
    if (o.pos - 1 > 0) items.push({ kind: "gap", count: o.pos - 1, state: "past", title: `${o.pos - 1} halte sebelumnya, mulai dari ${nameOf(o.firstId)}` });
    items.push(node(o.prevId, "past", o.pos - 1 === 0 ? "halte awal" : ""));
  }
  items.push({ kind: "node", id: stopId, name: stop.name, state: "here", role: "kamu di sini" });
  const isLast = o.pos === o.total - 1;
  if (!isLast) {
    const nextIsLast = o.pos + 1 === o.total - 1;
    items.push(node(o.nextId, nextIsLast ? "term" : "next", nextIsLast ? "halte akhir" : ""));
    const between = o.total - o.pos - 3;
    if (between > 0) items.push({ kind: "gap", count: between, state: "future", title: `${between} halte lagi sebelum ${nameOf(o.lastId)}` });
    if (!nextIsLast) items.push(node(o.lastId, "term", "halte akhir"));
  }
  return { towards: nameOf(o.lastId), from: nameOf(o.firstId), pos: o.pos + 1, total: o.total, isLast, items };
}
function contextFor(routeId) {
  const occ = ctx.get(String(routeId)) || [];
  const dirCount = occ[0]?.dirCount || 0;
  const dirsSeen = new Set(occ.map(o => o.dirIndex));
  return {
    rows: occ.map(trackFor),
    oneWay: dirCount > 1 && dirsSeen.size === 1,
  };
}
function summaryFor(c) {
  if (!c.rows.length) return "";
  const t = [...new Set(c.rows.map(r => r.towards))];
  return t.map(x => `arah ${x}`).join(" · ");
}

// Kawasan & halte terdekat
const { byStop } = stopGroups();
const group = byStop.get(stopId) || null;
const siblings = group ? group.stopIds.filter(id => id !== stopId) : [];
const me = coordOf(stopId);
const groupDist = id => (me && coordOf(id) ? formatDistance(distanceM(me, coordOf(id))) : null);
const nearby = nearbyStops(stopId, { limit: 6, exclude: siblings });
const routesAt = id => routesForStop(id, stopServices, routeLookup);
const places = placesNearStop(stopId);

// Peta mini: halte sekitar diberi nomor yang sama dengan nomor di kartu daftar
const numbered = [...siblings, ...nearby.map(n => n.id)].slice(0, 18);
const numOf = id => { const i = numbered.indexOf(id); return i >= 0 ? i + 1 : null; };
const where = id => {
  const c = coordOf(id);
  if (!me || !c) return null;
  return `${formatDistance(distanceM(me, c))} · ke ${compassDir(me, c)}`;
};
const TOKEN = import.meta.env.PUBLIC_MAPBOX_TOKEN;
const mapUrl = me ? staticStopMap({
  main: [me],
  others: numbered.map(id => { const c = coordOf(id); return c ? { ...c, label: numOf(id) } : null; }).filter(Boolean),
  token: TOKEN,
}) : null;

// Paragraf pembuka unik per halte
const corridorIds = serving.filter(r => categoryOf(r) === "brt").map(r => r.id);
const intro = [
  `Halte ${stop.name} adalah ${isBrt ? "halte BRT" : "halte non-BRT (bus stop di tepi jalan)"} yang dilayani ${serving.length} rute Transjakarta${corridorIds.length ? `, termasuk koridor BRT ${corridorIds.slice(0, 6).join(", ")}${corridorIds.length > 6 ? " dan lainnya" : ""}` : ""}.`,
  rail.length
    ? `Dari sini kamu bisa transit ke ${rail.slice(0, 3).map(r => `${r.name} (${r.mode.short}, ${r.integrated ? "terintegrasi" : `±${formatDistance(r.distance)}`})`).join(", ")}.`
    : modes.length ? `Dari sini kamu bisa transit ke ${modes.map(m => m.label).join(" dan ")}.` : "",
  group ? `Halte ini termasuk ${group.hasTerminal ? "kawasan " : ""}${group.name} bersama ${siblings.length} halte lain yang bisa dijangkau dengan berjalan kaki.` : "",
  !group && nearby.length ? `Halte terdekat adalah ${nameOf(nearby[0].id)} (sekitar ${formatDistance(nearby[0].distance)}).` : "",
].filter(Boolean).join(" ");
---
<BaseLayout
  title={`Halte ${stop.name}`}
  description={`Daftar ${serving.length} rute Transjakarta yang berhenti di halte ${stop.name}, lengkap dengan halte sebelum dan sesudahnya di tiap arah. ${typeLabel}${modes.length ? `, terhubung ke ${modes.map(m => m.label).join(", ")}` : ""}.`}
  canonicalPath={`/halte/${stopId}`}
>
  <div class="crumb"><a href="/halte">Daftar Halte</a>{group && <> / <a href={`/kawasan/${group.slug}`}>{group.name}</a></>} / <span>{stop.name}</span></div>
  <header class={`page-hero stop-hero2 ${isBrt ? "is-brt" : ""}`}>
    <span class="hero-pin" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12S4 16 4 10a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
    </span>
    <div class="hero-text">
      <p class="page-kicker">{typeLabel}</p>
      <h1>{stop.name}</h1>
      <ul class="soft-chips">
        <li><b>{serving.length}</b> rute berhenti di sini</li>
        {modes.map(m => <li class="mode-chip" style={`--m:${m.color}`}>Transit {m.label}</li>)}
        {stop.split_by_direction && <li>2 bangunan per arah</li>}
        {group && <li><a href={`/kawasan/${group.slug}`}>{group.name}</a></li>}
      </ul>
    </div>
  </header>

  <p class="stop-intro">{intro}</p>

  {stop.split_by_direction && (
    <aside class="callout split-callout">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 21V9l4-3 4 3v12"/><path d="M12 21V9l4-3 4 3v12"/><path d="M2 21h20"/></svg>
      <p><b>Halte ini terdiri dari 2 bangunan terpisah, satu untuk tiap arah.</b> Masuklah dari bangunan yang sesuai arah tujuanmu.
      Untuk berganti arah, kamu harus keluar (tap out) lalu masuk lagi (tap in) di bangunan seberang.</p>
    </aside>
  )}

  {rail.length > 0 && (
    <section class="rail-block">
      <h2 class="rail-title">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="5" y="3" width="14" height="14" rx="3"/><path d="M5 11h14"/><circle cx="9" cy="14" r=".9" fill="currentColor"/><circle cx="15" cy="14" r=".9" fill="currentColor"/><path d="m8 21 2-4M16 21l-2-4"/></svg>
        Transit ke Kereta
      </h2>
      <div class="rail-list">
        {rail.map(r => (
          <a href={`/stasiun/${r.slug}`} class="rail-item" style={`--m:${r.mode.color}`}>
            <span class="rail-badge">{r.mode.short}</span>
            <span class="rail-main">
              <b>{r.name}</b>
              <span class="rail-meta">
                {r.integrated && <span class="rail-int">Terintegrasi</span>}
                ±{formatDistance(r.distance)} jalan kaki{me && ` · ke ${compassDir(me, r)}`}
              </span>
              <span class="rail-lines">{(r.lines || []).map(l => <i style={`--l:${lineInfo(l).color}`}>{lineInfo(l).short}</i>)}</span>
            </span>
            <svg class="rail-chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 6 6 6-6 6"/></svg>
          </a>
        ))}
      </div>
    </section>
  )}

  {mapUrl && (
    <details class="map-toggle" id="stop-map">
      <summary>
        <span class="mt-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 4 3 6v14l6-2 6 2 6-2V4l-6 2-6-2Z"/><path d="M9 4v14M15 6v14"/></svg></span>
        <span class="mt-text"><b>Tampilkan peta</b><span>Lokasi {stop.name} dan {nearby.length + siblings.length} halte sekitar</span></span>
        <svg class="ctx-chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
      </summary>
      <figure class="mini-map">
        <img data-src={mapUrl} data-src-dark={mapUrl.replace("/streets-v12/", "/dark-v11/")} alt={`Peta lokasi halte ${stop.name} dan halte di sekitarnya`} width="760" height="320" />
        <figcaption><span class="mm-dot is-main"></span>{stop.name} <span class="mm-dot"></span>halte sekitar (nomor sesuai daftar di bawah)
          <a href={`https://www.google.com/maps/search/?api=1&query=${me.lat},${me.lng}`} target="_blank" rel="noopener nofollow">Buka di Google Maps</a>
        </figcaption>
      </figure>
    </details>
  )}
  <script>
    // Peta selalu tertutup saat halaman dibuka; gambar baru diminta ke Mapbox saat dibuka (hemat kuota).
    const box = document.getElementById("stop-map");
    if (box) {
      const img = box.querySelector("img[data-src]");
      box.addEventListener("toggle", () => { if (box.open && img && !img.src) img.src = window.mapSrcFor ? window.mapSrcFor(img) : img.dataset.src; });
      try { localStorage.removeItem("stopMapOpen"); } catch (e) {}
    }
  </script>

  {serving.length === 0 ? (
    <p class="lead">Belum ada data rute untuk halte ini.</p>
  ) : (
    <>
      {groups.map(g => (
        <section class="home-section">
          <div class="section-head"><h2>{g.label}</h2><span class="count">{g.items.length}</span></div>
          <div class="ctx-list">
            {g.items.map(r => {
              const c = contextFor(r.id);
              return (
                <details class="route-ctx" style={badgeVars(r.route_color)}>
                  <summary>
                    <span class="badge-bus">{r.id}</span>
                    <span class="ctx-sum">
                      <strong>{r.route_name}</strong>
                      <span class="sub">{summaryFor(c)}{c.oneWay ? " (satu arah saja)" : ""}</span>
                    </span>
                    <svg class="ctx-chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
                  </summary>
                  <div class="ctx-body">
                    {c.rows.map(row => (
                      <div class="ctx-dir">
                        <div class="ctx-head">
                          <p class="ctx-label">Menuju {row.towards}
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                          </p>
                          <span class="ctx-pos">dari {row.from} · halte ke-{row.pos} dari {row.total}</span>
                        </div>
                        <ol class="ctx-track" aria-label={`Urutan halte menuju ${row.towards}`}>
                          {row.items.map((it, i) => {
                            const prev = row.items[i - 1], next = row.items[i + 1];
                            const segL = prev ? (it.state === "past" || it.state === "here" ? "past" : "fut") : "";
                            const segR = next ? (it.state === "past" ? "past" : "fut") : "";
                            if (it.kind === "gap") return (
                              <li class={`ctx-gap is-${it.state}`}>
                                <a href={`/rute/${r.slug}`} title={it.title}>{it.count} halte</a>
                              </li>
                            );
                            return (
                              <li class={`ctx-node is-${it.state} ${segL && `l-${segL}`} ${segR && `r-${segR}`}`} aria-current={it.state === "here" ? "location" : undefined}>
                                <span class="ctx-dot" aria-hidden="true"></span>
                                {it.state === "here" && next && <span class="ctx-arrow" aria-hidden="true"></span>}
                                {it.state === "here" ? <b class="ctx-name">{it.name}</b> : <a class="ctx-name" href={`/halte/${it.id}`}>{it.name}</a>}
                                {it.role && <span class="ctx-role">{it.role}</span>}
                              </li>
                            );
                          })}
                          {row.isLast && <li class="ctx-endnote">Halte akhir. Bus tidak melanjutkan perjalanan di arah ini.</li>}
                        </ol>
                      </div>
                    ))}
                    {c.oneWay && <p class="ctx-note">Rute ini hanya berhenti di halte ini pada satu arah. Untuk arah sebaliknya, cek halte lain di sekitar sini.</p>}
                    <a class="ctx-more" href={`/rute/${r.slug}`}>Lihat rute {r.id} lengkap &rarr;</a>
                  </div>
                </details>
              );
            })}
          </div>
        </section>
      ))}
    </>
  )}

  {places.length > 0 && (
    <section class="home-section">
      <div class="section-head"><h2>Tempat di Sekitar</h2><span class="count">radius 600 m</span></div>
      <div class="place-chips">
        {places.map(pl => (
          <a href={`/tempat/${pl.slug}`} class="place-chip">
            <b>{pl.place.name}</b>
            <span>{placeCategoryLabel(pl.place.category)} · {formatDistance(pl.distance)} · ke {compassDir(me, pl.place)}</span>
          </a>
        ))}
      </div>
    </section>
  )}

  {group && siblings.length > 0 && (
    <section class="home-section">
      <div class="section-head"><h2>Halte Lain di {group.name}</h2><a href={`/kawasan/${group.slug}`}>Lihat kawasan &rarr;</a></div>
      <div class="grid near-grid">
        {siblings.map(id => {
          const rs = routesAt(id);
          return (
            <a href={`/halte/${id}`} class="near-card">
              <span class="near-top">{numOf(id) && <span class="near-num">{numOf(id)}</span>}<b>{nameOf(id)}</b></span>
              {where(id) && <span class="near-where">{where(id)}</span>}
              <span class="near-badges">
                {rs.slice(0, 8).map(r => <span class="badge-bus" style={badgeVars(r.route_color)}>{r.id}</span>)}
                {rs.length > 8 && <span class="service-more">+{rs.length - 8}</span>}
              </span>
            </a>
          );
        })}
      </div>
    </section>
  )}

  {nearby.length > 0 && (
    <section class="home-section">
      <div class="section-head"><h2>Halte Terdekat</h2><span class="count">radius 500 m</span></div>
      <div class="grid near-grid">
        {nearby.map(n => {
          const rs = routesAt(n.id);
          return (
            <a href={`/halte/${n.id}`} class="near-card">
              <span class="near-top">{numOf(n.id) && <span class="near-num">{numOf(n.id)}</span>}<b>{nameOf(n.id)}</b></span>
              {where(n.id) && <span class="near-where">{where(n.id)}</span>}
              <span class="near-badges">
                {rs.slice(0, 8).map(r => <span class="badge-bus" style={badgeVars(r.route_color)}>{r.id}</span>)}
                {rs.length > 8 && <span class="service-more">+{rs.length - 8}</span>}
              </span>
            </a>
          );
        })}
      </div>
      <p class="near-note">Nomor sesuai pin di peta. Jarak dihitung garis lurus. Rute jalan kaki sebenarnya bisa lebih jauh, terutama bila harus menyeberang jalan besar, tol, atau rel.</p>
    </section>
  )}
</BaseLayout>
