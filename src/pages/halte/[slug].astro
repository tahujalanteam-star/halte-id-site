---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { loadStops, loadRoutesIndex, loadStopServices, buildRouteLookup, routesForStop } from "../../lib/data.js";

export async function getStaticPaths() {
  const stops = loadStops();
  return Object.keys(stops).map(stopId => ({
    params: { slug: stopId },
    props: { stopId },
  }));
}

const { stopId } = Astro.props;
const stops = loadStops();
const stop = stops[stopId];
const stopServices = loadStopServices();
const routeLookup = buildRouteLookup(loadRoutesIndex());
const serving = routesForStop(stopId, stopServices, routeLookup);
const typeLabel = stop.type === "brt" ? "Halte BRT" : "Halte Non-BRT";
---
<BaseLayout
  title={`Halte ${stop.name}`}
  description={`Daftar rute Transjakarta & JakLingko yang berhenti di halte ${stop.name}. ${typeLabel}.`}
  canonicalPath={`/halte/${stopId}`}
>
  <div class="crumb"><a href="/halte">Daftar Halte</a> / <span>{stop.name}</span></div>
  <div class="stop-hero">
    <span class="badge-sub" style="background:#475569;">{typeLabel}</span>
    <h1 style="margin-top:0.4rem;">{stop.name}</h1>
    <div class="sub" style="color:var(--text-sub);">{serving.length} rute berhenti di halte ini</div>
  </div>

  <h2>Rute yang Berhenti di Sini</h2>
  {serving.length === 0 ? (
    <p class="lead">Belum ada data rute untuk halte ini.</p>
  ) : (
    <div>
      {serving.map(r => (
        <a href={`/rute/${r.slug}`} class="card">
          <span class="badge-bus" style={`background:${r.route_color || "#334155"};`}>{r.id}</span>
          <strong>{r.route_name}</strong>
        </a>
      ))}
    </div>
  )}
</BaseLayout>
