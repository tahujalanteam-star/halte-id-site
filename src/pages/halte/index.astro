---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { loadStops } from "../../lib/data.js";

const stops = loadStops();
const entries = Object.entries(stops).sort((a, b) => a[1].name.localeCompare(b[1].name));
---
<BaseLayout
  title="Daftar Semua Halte Bus Jakarta"
  description="Daftar lengkap seluruh halte Transjakarta dan JakLingko di Jakarta, cari berdasarkan nama halte."
  canonicalPath="/halte"
>
  <h1>Daftar Halte</h1>
  <p class="lead">{entries.length} halte tersedia.</p>
  <input id="stop-filter" class="search-input" type="search" placeholder="Cari nama halte..." />
  <div id="stop-grid" class="grid">
    {entries.map(([id, s]) => (
      <a href={`/halte/${id}`} class="card" data-name={s.name.toLowerCase()}>
        {s.name}
      </a>
    ))}
  </div>
  <p id="stop-empty" class="lead" hidden>Tidak ada halte yang cocok.</p>

  <script>
    const input = document.getElementById("stop-filter");
    const grid = document.getElementById("stop-grid");
    const empty = document.getElementById("stop-empty");
    const cards = Array.from(grid.querySelectorAll("[data-name]"));
    input.addEventListener("input", () => {
      const q = input.value.trim().toLowerCase();
      let visible = 0;
      cards.forEach(card => {
        const match = card.dataset.name.includes(q);
        card.hidden = !match;
        if (match) visible++;
      });
      empty.hidden = visible !== 0;
    });
  </script>
</BaseLayout>
