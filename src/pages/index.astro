---
import BaseLayout from "../layouts/BaseLayout.astro";
import { loadRoutesIndex, loadStops, routeSlug, compareCodes } from "../lib/data.js";

const routes = loadRoutesIndex().slice().sort((a, b) => compareCodes(a.id, b.id));
const stops = loadStops();
const popularRoutes = routes.slice(0, 8);

// Small client-side search index: route + stop names, built at build time.
const searchIndex = [
  ...routes.map(r => ({ type: "rute", label: `${r.id} — ${r.route_name}`, url: `/rute/${routeSlug(r)}` })),
  ...Object.entries(stops).map(([id, s]) => ({ type: "halte", label: s.name, url: `/halte/${id}` })),
];
---
<BaseLayout
  title={undefined}
  description="Panduan lengkap rute dan halte Transjakarta & JakLingko Jakarta — cari nomor rute, jadwal, tarif, dan daftar pemberhentian tiap koridor bus di Jakarta."
  canonicalPath="/"
>
  <h1>Panduan Rute &amp; Halte Bus Jakarta</h1>
  <p class="lead">
    Cari informasi lengkap rute Transjakarta dan JakLingko: jadwal keberangkatan, tarif, daftar halte pemberhentian,
    serta peta jalur tiap koridor — semua dalam satu tempat.
  </p>

  <input id="site-search" class="search-input" type="search" placeholder="Cari nomor rute atau nama halte..." />
  <ul id="search-results" class="results"></ul>

  <h2>Rute Populer</h2>
  <div class="grid">
    {popularRoutes.map(r => (
      <a href={`/rute/${routeSlug(r)}`} class="card">
        <span class="badge-bus" style={`background:${r.route_color || "#334155"};`}>{r.id}</span>
        <span>{r.route_name}</span>
      </a>
    ))}
  </div>
  <p><a href="/rute">Lihat semua {routes.length} rute &rarr;</a> &middot; <a href="/halte">Lihat semua {Object.keys(stops).length} halte &rarr;</a></p>

  <script type="application/json" id="search-data" set:html={JSON.stringify(searchIndex)} />
  <script>
    const data = JSON.parse(document.getElementById("search-data").textContent);
    const input = document.getElementById("site-search");
    const results = document.getElementById("search-results");
    input.addEventListener("input", () => {
      const q = input.value.trim().toLowerCase();
      results.innerHTML = "";
      if (!q) return;
      data
        .filter(item => item.label.toLowerCase().includes(q))
        .slice(0, 8)
        .forEach(item => {
          const li = document.createElement("li");
          const a = document.createElement("a");
          a.href = item.url;
          a.textContent = `${item.type === "rute" ? "🚌" : "📍"} ${item.label}`;
          li.appendChild(a);
          results.appendChild(li);
        });
    });
  </script>
</BaseLayout>
