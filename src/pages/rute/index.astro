---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { loadRoutesIndex, routeSlug, compareCodes } from "../../lib/data.js";

const routes = loadRoutesIndex().slice().sort((a, b) => compareCodes(a.id, b.id));
---
<BaseLayout
  title="Daftar Semua Rute Transjakarta & JakLingko"
  description="Daftar lengkap seluruh koridor dan rute Transjakarta serta JakLingko di Jakarta, beserta jumlah halte dan rute pemberhentian."
  canonicalPath="/rute"
>
  <h1>Daftar Rute</h1>
  <p class="lead">{routes.length} rute tersedia.</p>
  <input id="route-filter" class="search-input" type="search" placeholder="Cari nomor atau nama rute..." />
  <div id="route-list">
    {routes.map(r => (
      <a href={`/rute/${routeSlug(r)}`} class="card" data-name={`${r.id} ${r.route_name}`.toLowerCase()}>
        <span class="badge-bus" style={`background:${r.route_color || "#334155"};`}>{r.id}</span>
        <span>
          <strong>{r.route_name}</strong>
          <div class="sub">{r.stops_count} halte &middot; {r.start_stop} s/d {r.end_stop}</div>
        </span>
      </a>
    ))}
  </div>
  <p id="route-empty" class="lead" hidden>Tidak ada rute yang cocok.</p>
  <script>
    const input = document.getElementById("route-filter");
    const items = Array.from(document.querySelectorAll("#route-list [data-name]"));
    const empty = document.getElementById("route-empty");
    input.addEventListener("input", () => {
      const q = input.value.trim().toLowerCase();
      let n = 0;
      items.forEach(el => { const m = el.dataset.name.includes(q); el.hidden = !m; if (m) n++; });
      empty.hidden = n !== 0;
    });
  </script>
</BaseLayout>
