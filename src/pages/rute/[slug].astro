---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { routeMapUrl } from "../../lib/map-utils.js";
import {
  loadStops,
  loadRoutesIndex,
  loadRoute,
  loadStopServices,
  loadJalur,
  getDirectionGeometry,
  routeSlug,
  buildRouteLookup,
  routesForStop,
  badgeVars,
  readableText,
  categoryOf,
  categoryLabel,
} from "../../lib/data.js";

export async function getStaticPaths() {
  const routesIndex = loadRoutesIndex();
  return routesIndex.map(entry => ({
    params: { slug: routeSlug(entry) },
    props: { routeId: entry.id, summary: entry },
  }));
}

const { routeId, summary } = Astro.props;
const route = loadRoute(routeId);
const stops = loadStops();
const stopServices = loadStopServices();
const routeLookup = buildRouteLookup(loadRoutesIndex());
const jalur = loadJalur(routeId);

const MAX_VISIBLE_NON_BRT = 4;

// Badge koneksi per halte diambil dari stops.json (stop.transfers) — data curated,
// bukan stop-services.json. Rute utama (brt/mrt/krl/lrt/kai) selalu tampil;
// rute non-BRT/JAK dibatasi 4, sisanya lewat tombol "+N rute".
function transferBadges(stop) {
  const list = (stop.transfers || []).filter(t => String(t.line) !== String(route.id));
  const isNon = t => t.type === "nonbrt" || t.type === "jak";
  const decorate = t => {
    const info = routeLookup.get(String(t.line));
    return {
      line: String(t.line),
      type: t.type,
      non: isNon(t),
      href: info && ["brt", "nonbrt", "jak"].includes(t.type) ? `/rute/${info.slug}` : null,
      color: !isNon(t) && info?.entry?.route_color ? info.entry.route_color : null,
    };
  };
  const primary = list.filter(t => !isNon(t)).map(decorate);
  const non = list.filter(isNon).sort((a, b) => {
    const ja = String(a.line).toUpperCase().startsWith("JAK") || a.type === "jak";
    const jb = String(b.line).toUpperCase().startsWith("JAK") || b.type === "jak";
    if (ja !== jb) return ja ? 1 : -1;
    return String(a.line).localeCompare(String(b.line), undefined, { numeric: true, sensitivity: "base" });
  }).map(decorate);
  return { primary, visible: non.slice(0, MAX_VISIBLE_NON_BRT), hidden: non.slice(MAX_VISIBLE_NON_BRT) };
}

const directions = route.directions || [];
const schedule = route.timetable?.schedules?.[0];
const operatingDays = route.timetable?.operating_days;
// Info singkat untuk hero: moda yang terhubung & jumlah halte transit
const MODE_LABEL = { mrt: "MRT", lrt: "LRT", krl: "KRL", kai: "Kereta Bandara" };
const routeStopIds = [...new Set(directions.flatMap(d => d.stop_ids))];
const transferStops = routeStopIds.filter(id => (stops[id]?.transfers || []).some(t => String(t.line) !== String(route.id)));
const modes = [...new Set(routeStopIds.flatMap(id => (stops[id]?.transfers || []).map(t => t.type)))].filter(t => MODE_LABEL[t]).map(t => MODE_LABEL[t]);
const heroInfo = [modes.length ? `Terhubung ke ${modes.join(", ")}` : null, transferStops.length ? `${transferStops.length} halte transit` : null].filter(Boolean).join(" · ");
const category = categoryOf(summary);

const PUBLIC_MAPBOX_TOKEN = import.meta.env.PUBLIC_MAPBOX_TOKEN;

function staticMapUrl(dirId, dirIndex) {
  const geometry = getDirectionGeometry(jalur, dirId, dirIndex);
  return routeMapUrl(geometry, { color: route.route_color || "#D90429", token: PUBLIC_MAPBOX_TOKEN });
}
---
<BaseLayout
  title={`Rute ${route.id} — ${route.route_number}`}
  description={`Jadwal, tarif, dan daftar halte pemberhentian rute ${route.id} ${route.route_number}. ${operatingDays || ""} ${schedule ? `mulai ${schedule.first_departure} sampai ${schedule.last_departure}.` : ""}`}
  canonicalPath={`/rute/${routeSlug(summary)}`}
>
  <div class="crumb"><a href="/rute">Daftar Rute</a> / <span>{route.id}</span></div>

  <header class="route-hero" style={badgeVars(route.route_color, "#2563eb")}>
    <svg class="hero-line" viewBox="0 0 400 160" preserveAspectRatio="xMaxYMid slice" aria-hidden="true">
      <path d="M-10 124 C 40 124, 60 84, 110 84 S 170 40, 220 40 S 280 112, 330 112 S 390 64, 420 64" fill="none" stroke="currentColor" stroke-width="6" stroke-linecap="round"/>
      <circle cx="110" cy="84" r="9" fill="var(--c)" stroke="currentColor" stroke-width="5"/>
      <circle cx="220" cy="40" r="9" fill="var(--c)" stroke="currentColor" stroke-width="5"/>
      <circle cx="330" cy="112" r="9" fill="var(--c)" stroke="currentColor" stroke-width="5"/>
    </svg>
    <div class="hero-main">
      <span class="hero-badge">{route.id}</span>
      <div class="hero-text">
        <p class="hero-kicker">{categoryLabel(category)}</p>
        <h1>{route.route_number}</h1>
        {heroInfo && <p class="hero-sub">{heroInfo}</p>}
      </div>
    </div>
    <ul class="hero-chips">
      {operatingDays && <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4.5" width="18" height="17" rx="3"/><path d="M8 2.5v4M16 2.5v4M3 9.5h18"/></svg>{operatingDays}</li>}
      {schedule && <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3.5 2"/></svg>{schedule.first_departure} – {schedule.last_departure}</li>}
      <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 5.5h16a2 2 0 0 1 2 2v2.2a2.5 2.5 0 0 0 0 4.6v2.2a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2v-2.2a2.5 2.5 0 0 0 0-4.6V7.5a2 2 0 0 1 2-2Z"/><path d="M9 12h6"/></svg>Rp3.500</li>
      {summary.stops_count && <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 10c0 6-8 12-8 12S4 16 4 10a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>{summary.stops_count} halte</li>}
    </ul>
  </header>

  {directions.map((dir, dirIndex) => {
    const mapUrl = staticMapUrl(dir.id, dirIndex);
    const allNonBrt = dir.stop_ids.every(id => stops[id]?.type !== "brt");
    return (
      <section class="dir-card" data-dir-index={dirIndex}>
        <div class="dir-head">
          <h2>{dir.title}</h2>
          {directions.length > 1 && (
            <button type="button" class="dir-switch" hidden>Ubah arah</button>
          )}
        </div>
        {mapUrl && (
          <img class="route-map" data-src={mapUrl} data-src-dark={mapUrl.replace("/streets-v12/", "/dark-v11/")} loading="lazy" alt={`Peta jalur rute ${route.id} arah ${dir.title}`} width="800" height="360" />
        )}
        <ol class={`timeline${allNonBrt ? " nonbrt-line" : ""}`} style={`--route-color:${route.route_color || "#2563eb"};`}>
          {dir.stop_ids.map(stopId => {
            const stop = stops[stopId];
            if (!stop) return null;
            const tb = transferBadges(stop);
            return (
              <li class={`stop-item ${stop.type === "brt" ? "is-brt-item" : "is-nonbrt-item"}`}>
                <span class={stop.type === "brt" ? "stop-dot-brt" : "stop-dot-nonbrt"}></span>
                <a class="stop-list-name" href={`/halte/${stopId}`}>{stop.name}{stop.split_by_direction && <span class="split-tag" title="Bangunan terpisah per arah: ganti arah harus tap out lalu tap in lagi">2 bangunan</span>}</a>
                <div class="transfers-wrapper">
                  {[...tb.primary, ...tb.visible].map(t => (
                    t.href
                      ? <a href={t.href} class={`transfer-badge transfer-${t.type}${t.non ? " is-non-brt" : ""}`} style={t.color ? `background-color:${t.color};color:${readableText(t.color)};` : undefined}>{t.line}</a>
                      : <span class={`transfer-badge transfer-${t.type}${t.non ? " is-non-brt" : ""}`}>{t.line}</span>
                  ))}
                  {tb.hidden.length > 0 && (
                    <button type="button" class="btn-toggle-routes more-toggle" hidden>+{tb.hidden.length} rute</button>
                  )}
                  {tb.hidden.length > 0 && (
                    <span class="extra-routes" hidden>
                      {tb.hidden.map(t => (
                        t.href
                          ? <a href={t.href} class={`transfer-badge transfer-${t.type} is-non-brt`}>{t.line}</a>
                          : <span class={`transfer-badge transfer-${t.type} is-non-brt`}>{t.line}</span>
                      ))}
                      <button type="button" class="btn-toggle-routes less-toggle">&#8630; Tutup</button>
                    </span>
                  )}
                </div>
              </li>
            );
          })}
        </ol>
      </section>
    );
  })}

  <style>
    .transfers-wrapper { display: flex; flex-wrap: wrap; align-items: center; gap: 4px; }
    .transfer-badge { font-size: 0.68rem; padding: 2px 6px; border-radius: 10px; color: #fff; background-color: var(--muted);
      min-width: 20px; min-height: 20px; text-align: center; line-height: 16px; }
    a.transfer-badge:hover { text-decoration: none; opacity: 0.85; }
    .transfer-nonbrt, .transfer-jak { background: none; color: var(--text-sub); }
    .transfer-mrt { background-color: #db0000; }
    .transfer-krl { background-color: #db6300; }
    .transfer-lrt { background-color: #c2185b; }
    .transfer-kai { background-color: #1e3a8a; }
    .btn-toggle-routes { background: var(--badge-bg); color: var(--text-sub); border: 1px solid var(--border-color); border-radius: 4px; padding: 1px 6px;
      font-size: 0.75rem; font-weight: 600; cursor: pointer; font-family: inherit; }
    .btn-toggle-routes:hover { color: var(--text-main); border-color: var(--text-sub); }
    .extra-routes { display: inline-flex; flex-wrap: wrap; align-items: center; gap: 4px; }
    .dir-head { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-bottom: 0.75rem; }
    .dir-head h2 { margin: 0; }
    .dir-switch { border: 1px solid var(--border-color); background: var(--card-bg); color: var(--primary);
      border-radius: 999px; padding: 0.35rem 0.9rem; font-size: 0.85rem; font-weight: 600; cursor: pointer; white-space: nowrap; }
    .dir-switch:hover { border-color: var(--primary); }
  </style>
  <noscript><style is:inline>.extra-routes[hidden] { display: inline-flex !important; } .less-toggle { display: none; }</style></noscript>
  <script>
    // Tanpa JS (dan untuk mesin pencari) kedua arah tampil penuh.
    // Dengan JS: tampilkan satu arah, tombol "(Ubah arah)" menukar arah.
    const cards = Array.from(document.querySelectorAll(".dir-card[data-dir-index]"));
    // Peta hanya dimuat untuk arah yang sedang tampil (hemat kuota Mapbox)
    const loadMap = (card) => {
      const img = card && card.querySelector("img[data-src]");
      if (img && !img.src) img.src = window.mapSrcFor ? window.mapSrcFor(img) : img.dataset.src;
    };
    if (cards.length === 1) loadMap(cards[0]);
    if (cards.length > 1) {
      let current = 0;
      const show = (i) => {
        current = i;
        cards.forEach((c, idx) => { c.hidden = idx !== i; });
        loadMap(cards[i]);
      };
      cards.forEach(c => {
        const btn = c.querySelector(".dir-switch");
        if (!btn) return;
        btn.hidden = false;
        btn.addEventListener("click", () => {
          show((current + 1) % cards.length);
          window.scrollTo({ top: Math.max(0, cards[current].offsetTop - 140), behavior: "smooth" });
        });
      });
      show(0);
    }
    // "+N rute": tampilkan semua rute di halte itu (semua link tetap ada di HTML untuk SEO)
    document.querySelectorAll(".stop-item").forEach(item => {
      const more = item.querySelector(".more-toggle");
      const extra = item.querySelector(".extra-routes");
      if (!more || !extra) return;
      more.hidden = false;
      more.addEventListener("click", () => { extra.hidden = false; more.hidden = true; });
      item.querySelector(".less-toggle").addEventListener("click", () => { extra.hidden = true; more.hidden = false; });
    });
  </script>
</BaseLayout>
