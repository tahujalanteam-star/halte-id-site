---
import BaseLayout from "../layouts/BaseLayout.astro";

const steps = [
  {
    "title": "Siapkan kartu uang elektronik",
    "desc": "Semua transportasi publik di Jakarta menggunakan transaksi non-tunai. Gunakan e-money (Mandiri e-Money, BCA Flazz, BRI BRIZZI, BNI TapCash) atau kartu JakLingko."
  },
  {
    "title": "Pahami jenis halte dan stasiun",
    "desc": "Halte BRT Transjakarta berada di jalur khusus dengan barrier gate. Bus stop non-BRT berada di pinggir jalan tanpa barrier."
  },
  {
    "title": "Cari rute dan transit",
    "desc": "Gunakan pencarian rute di halte.id untuk mengecek titik integrasi antar-koridor atau perpindahan ke MRT, LRT, dan KRL."
  },
  {
    "title": "Tap in dan tap out",
    "desc": "Pastikan selalu tap in saat masuk dan tap out saat keluar agar saldo terpotong sesuai tarif terpadu."
  }
];

const topics = [
  {
    "id": "pembayaran", "color": "#2563eb", "icon": "card", "intro": "Semua moda di Jakarta sudah non-tunai. Ini pilihan cara bayarnya.",
    "title": "Pembayaran & Tiket",
    "items": [
      {
        "title": "Kartu Uang Elektronik (E-Money)",
        "desc": "Metode utama dan paling direkomendasikan. Kamu bisa menggunakan kartu keluaran bank nasional untuk semua moda transportasi seperti MRT, LRT, KRL, TransJakarta, dan JakLingko.",
        "tags": [
          "Mandiri e-Money",
          "BCA Flazz",
          "BRI BRIZZI",
          "BNI TapCash"
        ]
      },
      {
        "title": "Kartu Khusus Transportasi",
        "desc": "Dapat dibeli langsung di loket atau mesin tiket otomatis di stasiun KRL dan halte TransJakarta.",
        "tags": [
          "Kartu Multi Trip (KMT)",
          "Kartu JakLingko"
        ]
      },
      {
        "title": "Pembayaran Digital & QR Code",
        "desc": "Beberapa moda mendukung tiket digital berbasis aplikasi mobile.",
        "tags": [
          "Aplikasi MRTJ",
          "Aplikasi JakLingko",
          "QRIS / E-Wallet"
        ]
      },
      {
        "title": "Tips Saldo Minimal & Top Up",
        "desc": "Pastikan saldo minimal Rp10.000 sebelum menempelkan kartu di gate. Top up bisa dilakukan via Mobile Banking (HP ber-NFC), minimarket, ATM, atau Vending Machine stasiun/halte."
      }
    ]
  },
  {
    "id": "transit", "color": "#16a34a", "icon": "transit", "intro": "Pindah koridor atau ganti moda tanpa bingung dan tanpa bayar dobel.",
    "title": "Transit & Integrasi",
    "items": [
      {
        "title": "Transit Bebas Biaya (BRT TransJakarta)",
        "desc": "Kamu bisa berpindah antar-koridor di halte integrasi tanpa perlu tap out atau bayar lagi, selama tidak keluar dari area steril halte.",
        "tags": [
          "Tanpa Biaya Tambahan",
          "Dalam Halte Steril"
        ]
      },
      {
        "title": "Hub Integrasi Utama (CSW & Velbak)",
        "desc": "Simpul integrasi fisik berbentuk jembatan/bangunan megah yang menghubungkan busway dengan MRT Jakarta atau KRL secara nyaman.",
        "tags": [
          "CSW (TJ + MRT)",
          "Velbak (TJ + KRL)",
          "Dukuh Atas Hub"
        ]
      },
      {
        "title": "Tarif Integrasi Maksimal Rp10.000",
        "desc": "Perjalanan kombinasi (TransJakarta, MRT, LRT) dalam kurun waktu maksimal 180 menit dikenakan tarif terpadu maksimal Rp10.000 jika menggunakan Kartu JakLingko atau aplikasi digital.",
        "tags": [
          "Maksimal 180 Menit",
          "Tarif Terpadu"
        ]
      },
      {
        "title": "Tips Transit Cepat",
        "desc": "Selalu ikuti papan penunjuk arah (wayfinding) berwarna di dalam stasiun/halte dan pastikan tetap berjalan di jalur penumpang agar tidak salah keluar gate."
      }
    ]
  },
  {
    "id": "halte-stasiun", "color": "#db6300", "icon": "halte", "intro": "Kenali jenis halte, fasilitas, dan etika selama menunggu.",
    "title": "Halte & Stasiun",
    "items": [
      {
        "title": "Perbedaan Halte BRT & Bus Stop Non-BRT",
        "desc": "Halte BRT TransJakarta berada di jalur khusus (pintu tinggi) dengan barrier gate. Bus stop non-BRT berada di pinggir jalan biasa (pintu rendah) tanpa barrier gate.",
        "tags": [
          "Halte BRT (Pintu Tinggi)",
          "Bus Stop Non-BRT (Pintu Rendah)"
        ]
      },
      {
        "title": "Fasilitas Aksesibilitas & Ramah Disabilitas",
        "desc": "Sebagian besar stasiun MRT, LRT, dan halte BRT modern sudah dilengkapi ramp, lift prioritas, ubin pemandu (guiding block), dan toilet disabilitas.",
        "tags": [
          "Lift Prioritas",
          "Ramp",
          "Guiding Block"
        ]
      },
      {
        "title": "Area Komersial & Fasilitas Umum",
        "desc": "Stasiun integrasi utama menyediakan mesin ATM, minimarket, musala, toilet umum, dan area duduk yang nyaman.",
        "tags": [
          "Toilet & Musala",
          "Minimarket",
          "Vending Machine"
        ]
      },
      {
        "title": "Etika Antre di Halte & Stasiun",
        "desc": "Dahulukan penumpang yang keluar dari bus/kereta. Berdirilah di belakang garis kuning penanda antrean di platform."
      }
    ]
  },
  {
    "id": "mrt-lrt-krl", "color": "#db0000", "icon": "train", "intro": "Moda rel yang terhubung dengan Transjakarta di banyak titik.",
    "title": "MRT, LRT & KRL Commuter",
    "items": [
      {
        "title": "KRL Commuter Line",
        "desc": "Kereta komuter jarak jauh yang menghubungkan Jakarta dengan Jabodetabek. Sangat cepat dan ekonomis untuk perjalanan antar-wilayah.",
        "tags": [
          "Antar-Kota & Suburb",
          "Ekonomis",
          "Frekuensi Tinggi"
        ]
      },
      {
        "title": "MRT Jakarta (Jalur Ratangga)",
        "desc": "Moda transportasi cepat berbasis rel melayang dan bawah tanah yang menghubungkan Lebak Bulus hingga Bundaran HI.",
        "tags": [
          "Bawah Tanah & Melayang",
          "Sangat Tepat Waktu"
        ]
      },
      {
        "title": "LRT Jabodebek & LRT Jakarta",
        "desc": "Kereta ringan otomatis tanpa masinis yang melayani rute Jakarta, Depok, dan Bekasi serta koridor lokal Kelapa Gading.",
        "tags": [
          "Tanpa Masinis",
          "Konektivitas Suburb"
        ]
      },
      {
        "title": "Ketentuan Kereta Khusus Wanita (KKW)",
        "desc": "Kereta paling depan dan paling belakang pada KRL Commuter Line difungsikan khusus untuk penumpang wanita pada jam operasional."
      }
    ]
  }
];
const ICONS = {"card": "<rect x=\"2.5\" y=\"5\" width=\"19\" height=\"14\" rx=\"2.5\"/><path d=\"M2.5 10h19M6.5 15h4\"/>", "transit": "<path d=\"M4 8h14l-3.5-3.5\"/><path d=\"M20 16H6l3.5 3.5\"/>", "halte": "<path d=\"M4 21V8l8-5 8 5v13\"/><path d=\"M4 11h16\"/><path d=\"M9 21v-6h6v6\"/>", "train": "<rect x=\"5\" y=\"3\" width=\"14\" height=\"14\" rx=\"3\"/><path d=\"M5 10h14\"/><circle cx=\"9\" cy=\"13.5\" r=\"1\"/><circle cx=\"15\" cy=\"13.5\" r=\"1\"/><path d=\"m8 21 2-4M16 21l-2-4\"/>", "info": "<circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M12 11v5M12 8h.01\"/>"};
---
<BaseLayout
  title="Panduan Naik Transjakarta untuk Pemula"
  description="Panduan naik Transjakarta dan JakLingko: cara bayar dengan e-money, aturan tap in dan tap out, transit gratis antar-koridor, perbedaan halte BRT dan non-BRT, serta integrasi dengan MRT, LRT, dan KRL."
  canonicalPath="/panduan"
>
  <header class="page-head">
    <p class="page-kicker">Panduan</p>
    <h1>Panduan Naik Transjakarta &amp; Transportasi Jakarta</h1>
    <p class="lead">
      Baru pertama kali naik bus di Jakarta? Berikut cara memakai halte.id dan hal-hal dasar yang perlu
      diketahui sebelum naik Transjakarta, JakLingko, MRT, LRT, dan KRL.
    </p>
    <nav class="topic-nav" aria-label="Topik panduan">
      <a href="#langkah" style="--t:var(--primary)"><span class="tn-dot"></span>4 Langkah Awal</a>
      {topics.map(t => <a href={`#${t.id}`} style={`--t:${t.color}`}><span class="tn-dot"></span>{t.title}</a>)}
    </nav>
  </header>

  <section id="langkah" class="guide-steps">
    <h2>Baru Pertama di Jakarta? Ikuti 4 Langkah Ini</h2>
    <ol class="step-track">
      {steps.map((st, i) => (
        <li class="step">
          <span class="step-num">{i + 1}</span>
          <strong>{st.title}</strong>
          <p>{st.desc}</p>
        </li>
      ))}
    </ol>
    <div class="step-cta">
      <span>Siap mencari rute?</span>
      <a href="/rute" class="btn btn-primary">Buka daftar rute</a>
      <a href="/halte" class="btn">Cari halte</a>
    </div>
  </section>

  {topics.map(t => (
    <section id={t.id} class="guide-topic" style={`--t:${t.color}`}>
      <div class="topic-head">
        <span class="icon-tile"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={ICONS[t.icon]} /></span>
        <div>
          <h2>{t.title}</h2>
          <p>{t.intro}</p>
        </div>
      </div>
      <div class="topic-grid">
        {t.items.map(item => (
          <article class="topic-card">
            <h3>{item.title}</h3>
            <p>{item.desc}</p>
            {item.tags && (
              <div class="tags">{item.tags.map(tag => <span class="tag">{tag}</span>)}</div>
            )}
          </article>
        ))}
      </div>
    </section>
  ))}

  <aside class="callout">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" set:html={ICONS.info} />
    <p>Informasi tarif dan aturan dapat berubah sewaktu-waktu. Untuk kepastian, rujuk pengumuman resmi
    Transjakarta, MRT Jakarta, LRT, dan KAI Commuter.</p>
  </aside>
</BaseLayout>
